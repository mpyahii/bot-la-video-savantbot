TG_BOT_TOKEN=

# Used by direct Python development. Compose overrides this with its internal
# Local Bot API service URL.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

MAX_VIDEO_HEIGHT=1080
# Optional Netscape-format cookies file. Put youtube.txt in ./cookies and set:
# COOKIES_FILE=/run/cookies/youtube.txt
COOKIES_FILE=
MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUED_DOWNLOADS=8
DOWNLOAD_DIR=/tmp/bot-downloads
DOWNLOAD_RETENTION_HOURS=2
CLEANUP_INTERVAL_SECONDS=600
MIN_FREE_DISK_GB=5
DOWNLOAD_TIMEOUT_SECONDS=1800
TELEGRAM_READ_TIMEOUT=120
TELEGRAM_WRITE_TIMEOUT=120
TELEGRAM_CONNECT_TIMEOUT=30
TELEGRAM_POOL_TIMEOUT=30
